modules = ["nodejs-20", "web", "python-base-3.13", "postgresql-16"]
[agent]
expertMode = true
integrations = ["github:1.0.0", "javascript_anthropic_ai_integrations:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
PORT = "5000"
JWT_SECRET = "replit-dev-jwt-secret-change-in-production"
VITE_APP_TITLE = "ERP Gestão Integrada"
VITE_APP_LOGO = "/fc-logo.png"
NODE_ENV = "development"
OAUTH_SERVER_URL = "https://forge.manus.ai"
VITE_OAUTH_PORTAL_URL = "https://manus.im"
VITE_APP_ID = "W4MM458SKqYRWRGGQrfw8A"
NEON_DATABASE_URL = "postgresql://neondb_owner:npg_z04uOWlTndZF@ep-young-water-ac67nuby-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
SMTP_HOST = "mail.fcengenhariacivil.com.br"
SMTP_PORT = "465"
SMTP_EMAIL = "rh@fcengenhariacivil.com.br"

[userenv.development]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 NODE_ENV=development pnpm dev"
waitForPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_OPTIONS='--max-old-space-size=2048' NODE_ENV=production node dist/index.js"]
build = ["pnpm", "run", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 5000
